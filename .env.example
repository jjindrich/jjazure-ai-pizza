# Local development uses in-memory catalog and orders by default.
# To test Azure-backed stores locally, set PIZZA_STORAGE_MODE=azure and provide:
# Pizza__Azure__CosmosEndpoint=
# Pizza__Azure__CosmosDatabase=PizzaCatalog
# Pizza__Azure__CosmosContainer=Pizzas
# Pizza__Azure__StorageAccountUrl=
# Pizza__Azure__ImagesContainer=pizza-images
# Pizza__Azure__SqlConnectionString=Server=tcp:<server>.database.windows.net,1433;Database=PizzaOrders;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication=Active Directory Default;
