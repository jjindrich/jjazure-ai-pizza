# Local PizzaOps development uses in-memory fallbacks only.
# PizzaOps__AllowLocalFallbacks=true
# PizzaOps__FoundryEndpoint=https://<account>.services.ai.azure.com/api/projects/<project>
# PizzaOps__FoundryAgentName=pizzaops-agent
# PizzaOps__GraphWebhookClientState=<random-secret>
# AzureAd__ClientId=<agent-blueprint-client-id>
# AzureAd__TenantId=<tenant-id>
# AzureAd__ClientCredentials__0__SourceType=SignedAssertionFromManagedIdentity
# AzureAd__ClientCredentials__0__ManagedIdentityClientId=<container-app-uami-client-id>
# PizzaOps__CosmosEndpoint=https://<account>.documents.azure.com:443/
# PizzaOps__CosmosDatabase=pizzaops
# PizzaOps__CosmosTasksContainer=tasks
# PizzaOps__CosmosEventsContainer=events
# PizzaOps__ServiceBusNamespace=<namespace>.servicebus.windows.net
# PizzaOps__ServiceBusQueue=pizzaops-wakeups
# PizzaOps__AllowedTenantId=<tenant-id>
# PizzaOps__AllowedIssuers=https://login.microsoftonline.com/<tenant-id>/v2.0;https://sts.windows.net/<tenant-id>/
# Api__Audience=api://<tool-api-audience>
# Api__AllowedClientId=<foundry-project-managed-identity-client-id>
